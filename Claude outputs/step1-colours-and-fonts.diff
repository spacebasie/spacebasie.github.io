diff --git a/_sass/_custom.scss b/_sass/_custom.scss
new file mode 100644
index 0000000..e6f5f24
--- /dev/null
+++ b/_sass/_custom.scss
@@ -0,0 +1,193 @@
+/* ==========================================================================
+   CUSTOM: olive & sand look
+   Loaded last in assets/css/main.scss so these rules override the theme.
+   Colours and fonts live in _variables.scss.
+   ========================================================================== */
+
+/* Base
+   ========================================================================== */
+
+body {
+  background-color: $background-color;
+  line-height: 1.7;
+}
+
+::selection {
+  color: $olive-ink;
+  background: mix(#fff, $olive, 70%);
+}
+
+h1, h2, h3, h4, h5, h6 {
+  color: $olive-ink;
+  font-weight: 600;
+}
+
+.page__title {
+  font-size: $type-size-2;
+  line-height: 1.15;
+  margin-bottom: 0.6em;
+}
+
+/* Section headings: thin rule with a short olive accent bar */
+.page__content h2,
+.archive h2 {
+  position: relative;
+  margin-top: 2.2em;
+  padding-bottom: 0.4em;
+  font-size: $type-size-3;
+  border-bottom: 1px solid $border-color;
+
+  &::after {
+    content: "";
+    position: absolute;
+    left: 0;
+    bottom: -1px;
+    width: 3em;
+    height: 3px;
+    background: $primary-color;
+  }
+}
+
+/* Links: softer underline */
+.page__content a,
+.archive a {
+  text-decoration-thickness: 1px;
+  text-underline-offset: 3px;
+
+  &:hover {
+    color: $link-color-hover;
+  }
+}
+
+/* Lists: olive bullets, a little tighter */
+.page__content,
+.archive {
+  ul li {
+    margin-bottom: 0.35em;
+  }
+
+  li::marker {
+    color: $primary-color;
+  }
+}
+
+/* Experience / research / projects entries:
+   role on its own line, location and dates muted underneath */
+.archive h2 + p {
+  > strong:first-child {
+    display: block;
+    font-size: 1.05em;
+  }
+
+  > em {
+    color: $olive-muted;
+    font-style: normal;
+    font-size: 0.9em;
+  }
+}
+
+/* Top navigation
+   ========================================================================== */
+
+.masthead {
+  background: $background-color;
+  border-bottom: 1px solid $border-color;
+}
+
+.masthead__inner-wrap {
+  padding: 0.9em 1em;
+}
+
+.masthead__menu-item--lg a {
+  color: $olive-ink;
+  font-family: $header-font-family;
+  font-size: 1.15em;
+  font-weight: 600;
+}
+
+.greedy-nav {
+  background: transparent;
+
+  .visible-links a:before {
+    height: 2px;
+    background: $primary-color;
+  }
+
+  button {
+    border-radius: $border-radius;
+  }
+
+  .hidden-links {
+    background: $background-color;
+
+    &:after {
+      border-color: $background-color transparent;
+    }
+
+    a:hover {
+      background: $sand-dark;
+    }
+  }
+}
+
+/* Sidebar / author profile
+   ========================================================================== */
+
+.author__avatar img {
+  aspect-ratio: 1 / 1;
+  object-fit: cover;
+  object-position: 50% 35%;
+  border-radius: 50%;
+
+  @include breakpoint($large) {
+    padding: 0;
+    border: 4px solid $sand-dark;
+  }
+}
+
+.sidebar .author__name {
+  font-family: $header-font-family;
+  font-size: $type-size-4;
+  font-weight: 600;
+}
+
+.author__bio {
+  color: $olive-muted;
+}
+
+.author__urls {
+  background: $background-color;
+
+  &:after {
+    border-color: $background-color transparent;
+  }
+
+  a {
+    color: $olive-ink;
+
+    &:hover {
+      color: $primary-color;
+      text-decoration: none;
+    }
+  }
+
+  i {
+    color: $primary-color;
+  }
+}
+
+/* Footer
+   ========================================================================== */
+
+.page__footer {
+  color: $olive-muted;
+  background-color: $sand-dark;
+  border-top: 1px solid $border-color;
+
+  .fas,
+  .fab,
+  .far,
+  .fal {
+    color: $olive-muted;
+  }
+}
